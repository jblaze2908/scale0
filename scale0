#!/usr/bin/env bash
# scale0: opt services on this host into scale-to-zero. A service sleeps (container stopped) after IDLE with no
# connection and wakes on its next request, which waits in the socket's queue until the service is healthy.
#   scale0 enable <name>    hold the address in /etc/scale0/<name>.env (copy examples/service.env)
#   scale0 disable <name>   stop holding it (the service is left awake; point its bind back at LISTEN yourself)
#   scale0 status           every opted-in service: awake or asleep, and since when
#   scale0 wake|sleep <name>
#   scale0 restart <name>   sleep then wake: deploys use it so a new image takes over
#   scale0 managed <name>   exit 0 when <name> is opted in (for deploy scripts)
#   scale0 deploy add <app> <repo-dir>   deploy <app> from <repo-dir>/deploy/app.conf on a 2-minute timer
#   scale0 deploy remove <app> | status | run <app> | rollback <app> <commit>
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CONF=/etc/scale0
NAME_RE='^[a-z][a-z0-9-]{0,30}$'

die() { echo "scale0: $*" >&2; exit 1; }
need_name() { [[ "${1:-}" =~ $NAME_RE ]] || die "give a service name (${NAME_RE})"; }
field() { sed -n "s/^$2=//p" "$CONF/$1.env" | tail -1; }

enable() {
  local name="$1"
  [[ -f "$CONF/$name.env" ]] || die "no $CONF/$name.env: copy $REPO/examples/service.env there and fill it in"
  install -d -m 755 /usr/local/lib/scale0 "/etc/systemd/system/scale0@$name.socket.d"
  # 644: no secrets here (COMPOSE_ARGS names the env file, it does not hold it), and the status page reads it
  chmod 644 "$CONF/$name.env"
  local listen target
  listen="$(field "$name" LISTEN)"; target="$(field "$name" TARGET)"
  [[ "$listen" =~ ^[0-9.]+:[0-9]+$ && "$target" =~ ^[0-9.]+:[0-9]+$ ]] || die "LISTEN and TARGET must be ip:port"
  [[ "$listen" != "$target" ]] || die "LISTEN and TARGET must differ: the service binds TARGET, scale0 holds LISTEN"
  install -m 755 "$REPO/lib/up.sh" "$REPO/lib/down.sh" /usr/local/lib/scale0/
  install -m 644 "$REPO"/units/scale0@.socket "$REPO"/units/scale0@.service "$REPO"/units/scale0-up@.service "$REPO"/units/scale0-status.service /etc/systemd/system/
  printf '[Socket]\nListenStream=%s\n' "$listen" >"/etc/systemd/system/scale0@$name.socket.d/listen.conf"
  systemctl daemon-reload
  if ss -Hltn "( sport = :${listen##*:} )" | grep -q . && ! systemctl is-active --quiet "scale0@$name.socket"; then
    die "$listen is still bound (the service itself?). Move its bind to $target, then run enable again"
  fi
  systemctl enable --now "scale0@$name.socket"
  # files only: a running DynamicUser of the same name would satisfy a plain id check
  getent -s files passwd scale0-status >/dev/null || useradd --system --no-create-home --shell /usr/sbin/nologin scale0-status
  # lets the status page's user start and stop scale0's own units (the dashboard's wake and sleep buttons)
  install -d -m 755 /etc/polkit-1/rules.d && install -m 644 "$REPO/polkit/50-scale0.rules" /etc/polkit-1/rules.d/
  systemctl enable --now scale0-status.service
  echo "$name: scale-to-zero on $listen → $target, sleeps after $(field "$name" IDLE) idle"
}

disable() {
  systemctl disable --now "scale0@$1.socket" "scale0@$1.service" 2>/dev/null || true
  echo "$1: no longer held; it stays as it is now ($(systemctl is-active "scale0-up@$1.service" || true))"
}

status() {
  shopt -s nullglob
  local f name state since
  printf '%-14s %-8s %s\n' SERVICE STATE SINCE
  for f in "$CONF"/*.env; do
    name="$(basename "$f" .env)"
    if ! systemctl is-active --quiet "scale0@$name.socket"; then state=off
    elif systemctl is-active --quiet "scale0-up@$name.service"; then state=awake
    else state=asleep; fi
    since="$(systemctl show -p StateChangeTimestamp --value "scale0-up@$name.service")"
    printf '%-14s %-8s %s\n' "$name" "$state" "${since:-–}"
  done
}

# Stopping the proxy while its socket stays up is the point; drop systemd's warning that the socket is still active.
nap() { systemctl stop "scale0@$1.service" "scale0-up@$1.service" 2> >(grep -v -e "triggering units are still active" -e "^scale0@.*\.socket$" >&2); }

# The page's user and its polkit rule, shared by enable and deploy add.
page_user() {
  getent -s files passwd scale0-status >/dev/null || useradd --system --no-create-home --shell /usr/sbin/nologin scale0-status
  install -d -m 755 /etc/polkit-1/rules.d && install -m 644 "$REPO/polkit/50-scale0.rules" /etc/polkit-1/rules.d/
}

deploy() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    add)
      need_name "${1:-}"; local app="$1" dir="${2:?usage: scale0 deploy add <app> <repo-dir>}"
      # An app moving over from its own script may not have pulled the commit that adds app.conf yet: take its branch's files.
      if [[ ! -f "$dir/deploy/app.conf" ]] && git -C "$dir" -c safe.directory="$dir" fetch -q origin 2>/dev/null \
         && git -C "$dir" -c safe.directory="$dir" cat-file -e FETCH_HEAD:deploy/app.conf 2>/dev/null; then
        git -C "$dir" -c safe.directory="$dir" checkout -q --detach FETCH_HEAD
      fi
      [[ -f "$dir/deploy/app.conf" ]] || die "no $dir/deploy/app.conf"
      page_user
      install -d -m 755 /etc/scale0/apps && printf '%s\n' "$(cd "$dir" && pwd)" >"/etc/scale0/apps/$app"
      install -d -m 750 -g scale0-status /var/lib/scale0-deploy "/var/lib/scale0-deploy/$app"
      install -m 644 "$REPO"/units/scale0-deploy@.service "$REPO"/units/scale0-deploy@.timer "$REPO"/units/scale0-deploy-now@.service "$REPO"/units/scale0-rollback@.service /etc/systemd/system/
      systemctl daemon-reload && systemctl enable --now "scale0-deploy@$app.timer"
      echo "$app: deploys from $dir on a 2-minute timer (turn its old timer off yourself)" ;;
    remove) need_name "${1:-}"; systemctl disable --now "scale0-deploy@$1.timer"; rm -f "/etc/scale0/apps/$1"; echo "$1: no longer deployed by scale0 (state kept)" ;;
    status) python3 "$REPO/lib/deployer.py" status ;;
    run) need_name "${1:-}"; python3 "$REPO/lib/deployer.py" run "$1" "${@:2}" ;;
    rollback) need_name "${1:-}"; python3 "$REPO/lib/deployer.py" rollback "$1" "${2:?give a commit}" ;;
    *) die "deploy: add, remove, status, run, rollback" ;;
  esac
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  status) status ;;
  enable) need_name "${1:-}"; enable "$1" ;;
  disable) need_name "${1:-}"; disable "$1" ;;
  wake) need_name "${1:-}"; systemctl start "scale0@$1.service" ;;
  sleep) need_name "${1:-}"; nap "$1" ;;
  restart) need_name "${1:-}"; nap "$1"; systemctl start "scale0@$1.service" ;;
  managed) need_name "${1:-}"; systemctl is-enabled --quiet "scale0@$1.socket" ;;
  deploy) deploy "$@" ;;
  *) die "unknown command: $cmd (enable, disable, status, wake, sleep, restart, managed, deploy)" ;;
esac
