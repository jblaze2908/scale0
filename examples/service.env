# /etc/scale0/<name>.env: one opted-in service. Your reverse proxy keeps pointing at LISTEN; scale0 holds it.
# The service binds TARGET instead. IDLE is how long with no open connection (a WebSocket counts) before it sleeps:
# longer than the cold start, and longer than the gaps between a client's requests.
LISTEN=172.17.0.1:8080
TARGET=127.0.0.1:18080
IDLE=10min
# Where `docker compose` runs and how: COMPOSE_ARGS may name an --env-file, but secrets stay in that file, not here.
COMPOSE_DIR=/opt/myapp
COMPOSE_ARGS=-p myapp -f deploy/compose.yml --env-file /etc/myapp/myapp.env
SERVICE=app
HEALTH_URL=http://127.0.0.1:18080/healthz
# Optional: --no-deps when a wake shouldn't rerun one-shot dependencies such as migrations.
# UP_ARGS=--no-deps
