# The status page: read-only, unprivileged, no Docker socket. Bound host-local; reach it through Traefik with SSO or an
# SSH tunnel (ssh -L 8359:172.17.0.1:8359 <host>).
[Unit]
Description=scale0 status page
After=network.target

[Service]
Environment=SCALE0_STATUS_BIND=172.17.0.1
Environment=SCALE0_STATUS_PORT=8359
ExecStart=/usr/bin/python3 /opt/scale0/status/server.py
# A fixed system user (made by `scale0 enable`), not DynamicUser: D-Bus has refused dynamic users on some hosts ("Transport
# endpoint is not connected"), so every systemctl call failed and the page showed every service as off.
User=scale0-status
Group=scale0-status
# remembers each service's last awake memory, so an asleep one can say what it frees
StateDirectory=scale0-status
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=false
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
Restart=on-failure

[Install]
WantedBy=multi-user.target
